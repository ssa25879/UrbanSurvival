  m_GameObject: {fileID: 52325041}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3017cd43176c3514c9659942bacffc88, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialPopup
  root: {fileID: 52325041}
  bodyText: {fileID: 1235079538}
  koreanTexts:
  - {fileID: 1235079538}
  - {fileID: 1209657741}
  - {fileID: 325761173}
  body: "<color=#EDBD5C>\uC5F0\uC2B5 \uBAA8\uB4DC\uB780?</color>\n\uBCF4\uC2A4 \uD55C
    \uB9C8\uB9AC\uC640 \uC77C\uB300\uC77C\uB85C \uC2F8\uC6B0\uBA70 \uCC98\uCE58\uC5D0
    \uAC78\uB9B0 \uC2DC\uAC04\uC744 \uC7AC\uB294 \uBAA8\uB4DC\uC785\uB2C8\uB2E4.\n\n<color=#EDBD5C>VS
    BOSS / VS FINAL BOSS</color>\nVS BOSS\uB294 \uAC8C\uC784 \uC2DC\uAC04 10\uBD84,
    VS FINAL BOSS\uB294 30\uBD84\uC774 \uC9C0\uB09C \uC0C1\uD0DC\uB85C \uC2DC\uC791\uD569\uB2C8\uB2E4.
    \uC2DC\uAC04\uC774 \uC9C0\uB09C \uB9CC\uD07C \uBCF4\uC2A4\uAC00 \uB354 \uAC15\uD569\uB2C8\uB2E4.\n\n<color=#EDBD5C>\uC5F0\uC2B5
    \uC870\uAC74</color>\n\uBB34\uAE30 4\uC885\uC744 \uBAA8\uB450 \uAC00\uC9C0\uACE0
    \uC2DC\uC791\uD558\uBA70, \uBCF4\uC2A4 \uC678\uC758 \uC801\uC740 \uB098\uC624\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4. \uD0C4\uC57D\uC774 \uBC14\uB2E5\uB098\uBA74 \uC790\uB3D9\uC73C\uB85C
    \uCC44\uC6CC\uC9D1\uB2C8\uB2E4.\n\n<color=#EDBD5C>\uAE30\uB85D</color>\n\uBCF4\uC2A4\uAC00
    \uB098\uD0C0\uB09C \uC21C\uAC04\uBD80\uD130 \uCC98\uCE58\uAE4C\uC9C0\uC758 \uC2DC\uAC04\uC774
    \uD45C\uC2DC\uB418\uACE0 \uCD5C\uACE0 \uAE30\uB85D\uC740 \uC800\uC7A5\uB429\uB2C8\uB2E4.
    \uBCF4\uC2A4\uB97C \uCC98\uCE58\uD558\uBA74 \uACB0\uACFC \uD654\uBA74\uC5D0\uC11C
    \uB2E4\uC2DC \uB3C4\uC804\uD558\uAC70\uB098 \uC5F0\uC2B5 \uC120\uD0DD\uC73C\uB85C
    \uB3CC\uC544\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<color=#EDBD5C>\uC8FC\uC758</color>\n\uBC14\uB2E5\uC758
    \uBD89\uC740 \uC6D0(\uB808\uB4DC\uC874)\uC740 \uC7A0\uC2DC \uB4A4 \uD3ED\uBC1C\uD569\uB2C8\uB2E4.
    \uBC94\uC704 \uBC16\uC73C\uB85C \uC774\uB3D9\uD574 \uD53C\uD558\uC138\uC694."
