  m_Script: {fileID: 11500000, guid: 3017cd43176c3514c9659942bacffc88, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialPopup
  root: {fileID: 1813784081}
  bodyText: {fileID: 236440288}
  koreanTexts:
  - {fileID: 236440288}
  - {fileID: 1828770413}
  - {fileID: 1675916913}
  body: "<color=#EDBD5C>\uBAA9\uD45C</color>\n30\uBD84 \uB3D9\uC548 \uC0B4\uC544\uB0A8\uACE0,
    30\uBD84\uC5D0 \uB098\uC624\uB294 \uBCF4\uC2A4\uB97C \uCC98\uCE58\uD558\uC138\uC694.
    \uCC98\uCE58\uD558\uBA74 \uBB34\uD55C \uBAA8\uB4DC\uB85C \uC774\uC5B4\uC11C \uB3C4\uC804\uD560\uC9C0
    \uACE0\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<color=#EDBD5C>\uC870\uC791</color>\nWASD
    \uC774\uB3D9   /   \uB9C8\uC6B0\uC2A4 \uC870\uC900   /   \uC88C\uD074\uB9AD \uBC1C\uC0AC\nR
    \uC7AC\uC7A5\uC804   /   1~4 \uBB34\uAE30 \uAD50\uCCB4   /   ESC \uC77C\uC2DC\uC815\uC9C0\n\n<color=#EDBD5C>\uBB34\uAE30\uC640
    \uBCF4\uAE09</color>\n\uAD8C\uCD1D\uC740 \uAE30\uBCF8 \uBB34\uAE30\uC774\uBA70
    \uD0C4\uC57D\uC774 \uBB34\uC81C\uD55C\uC785\uB2C8\uB2E4. \uC18C\uCD1D\xB7SMG\xB7\uC0B0\uD0C4\uCD1D\uC740
    \uC801\uC744 \uCC98\uCE58\uD558\uBA74 \uB4DC\uB78D\uB418\uACE0, \uD0C4\uC57D\uACFC
    \uD68C\uBCF5 \uC0C1\uC790\uB3C4 \uB4DC\uB78D\uB429\uB2C8\uB2E4.\n\n<color=#EDBD5C>\uBCF4\uC2A4</color>\n10\uBD84\uB9C8\uB2E4
    \uBCF4\uC2A4\uAC00 \uB098\uD0C0\uB0A9\uB2C8\uB2E4. \uBC14\uB2E5\uC5D0 \uBD89\uC740
    \uC6D0(\uB808\uB4DC\uC874)\uC774 \uC0DD\uAE30\uBA74 \uACE7 \uD3ED\uBC1C\uD558\uB2C8
    \uBC94\uC704 \uBC16\uC73C\uB85C \uBC97\uC5B4\uB098\uC138\uC694.\n\n<color=#EDBD5C>\uD301</color>\n\uD0C4\uCC3D\uC774
    \uBE44\uC5B4\uB3C4 \uC790\uB3D9\uC73C\uB85C \uC7AC\uC7A5\uC804\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
    R \uD0A4\uB97C \uB204\uB974\uAC70\uB098 \uB2E4\uC2DC \uD074\uB9AD\uD574\uC11C
    \uC7AC\uC7A5\uC804\uD558\uC138\uC694."
  prefsKey: TutorialSeen_Game
  showEveryTime: 0
  dontShowButton: {fileID: 1329474821}
  dontShowText: {fileID: 1675916913}
